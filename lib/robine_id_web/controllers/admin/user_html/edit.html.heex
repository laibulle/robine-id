<Layouts.portal flash={@flash} current_user={@current_user} theme={@theme} title="Manage user">
  <div class="mx-auto max-w-3xl">
    <a
      href={RobineId.Runtime.path("/admin/users")}
      class="inline-flex items-center gap-2 text-sm font-semibold text-slate-600 transition hover:text-teal-800"
    ><.icon name="hero-arrow-left" class="size-4" />Back to users</a>
    <section
      class="mt-6 rounded-3xl border border-slate-200/80 bg-white p-7 shadow-xl shadow-slate-900/5 sm:p-10"
      aria-labelledby="manage-user-title"
    >
      <p class="mb-2 text-xs font-bold uppercase tracking-[0.18em] text-teal-700">
        Administrative override
      </p>
      <h1 id="manage-user-title" class="text-3xl font-bold tracking-tight text-slate-900">
        Manage {@user.name}
      </h1>
      <p class="mt-3 break-all font-mono text-xs text-slate-500">
        {@user.identifier} · {@user.id}
      </p>

      <.form
        for={@form}
        id="admin-user-form"
        action={user_path(@user.id)}
        method="put"
        class="mt-8 grid gap-5"
      >
        <.input field={@form[:name]} label="Display name" required />
        <.input field={@form[:email]} type="email" label="Email address" required />
        <.input field={@form[:roles]} label="Roles" placeholder="admin, support" required />
        <p class="-mt-3 text-xs leading-5 text-slate-500">
          Comma-separated lowercase identifiers. The
          <code class="rounded bg-slate-100 px-1 py-0.5">admin</code>
          role grants access to this area.
        </p>
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
          <.input field={@form[:enabled]} type="checkbox" label="Account enabled" />
          <p class="text-xs leading-5 text-slate-500">
            Disabled users cannot sign in and existing browser sessions stop being reusable.
          </p>
        </div>
        <div class="mt-2 flex justify-end">
          <button
            id="admin-user-save"
            type="submit"
            class="rounded-xl bg-teal-700 px-6 py-3 font-semibold text-white shadow-lg shadow-teal-900/10 transition hover:-translate-y-0.5 hover:bg-teal-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700"
          >Save user</button>
        </div>
      </.form>
    </section>
  </div>
</Layouts.portal>
