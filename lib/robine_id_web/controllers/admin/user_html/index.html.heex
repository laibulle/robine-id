<Layouts.portal
  flash={@flash}
  current_user={@current_user}
  theme={@theme}
  title="User administration"
>
  <section aria-labelledby="users-title">
    <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
      <div>
        <p class="mb-2 text-xs font-bold uppercase tracking-[0.18em] text-teal-700">
          Administration
        </p>
        <h1 id="users-title" class="text-3xl font-bold tracking-tight text-slate-900">
          Configured users
        </h1>
        <p class="mt-3 max-w-2xl leading-7 text-slate-600">
          Users remain provisioned by the configuration file. Changes made here are stored as durable SQLite overrides.
        </p>
      </div>
      <span class="w-fit rounded-full bg-slate-200 px-3 py-1.5 text-sm font-semibold text-slate-700">{length(
        @users
      )} users</span>
    </div>

    <div class="mt-8 overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-xl shadow-slate-900/5">
      <div class="overflow-x-auto">
        <table id="admin-users-table" class="w-full min-w-[48rem] text-left">
          <thead class="border-b border-slate-200 bg-slate-50 text-xs uppercase tracking-wider text-slate-500">
            <tr>
              <th class="px-6 py-4 font-semibold">User</th><th class="px-6 py-4 font-semibold">
                Identifier
              </th><th class="px-6 py-4 font-semibold">Roles</th><th class="px-6 py-4 font-semibold">
                Status
              </th><th class="px-6 py-4 text-right font-semibold">
                <span class="sr-only">Actions</span>
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <tr
              :for={user <- @users}
              id={"admin-user-#{user.id}"}
              class="transition hover:bg-slate-50/80"
            >
              <td class="px-6 py-5">
                <div class="font-semibold text-slate-900">{user.name}</div><div class="mt-1 text-sm text-slate-500">
                  {user.email}
                </div>
              </td>
              <td class="px-6 py-5 font-mono text-xs text-slate-600">{user.identifier}</td>
              <td class="px-6 py-5">
                <div class="flex flex-wrap gap-1.5">
                  <span
                    :for={role <- user.roles}
                    class="rounded-full bg-teal-100 px-2.5 py-1 text-xs font-semibold text-teal-800"
                  >{role}</span><span :if={user.roles == []} class="text-sm text-slate-400">None</span>
                </div>
              </td>
              <td class="px-6 py-5">
                <span class={[
                  "inline-flex items-center gap-2 rounded-full px-2.5 py-1 text-xs font-semibold",
                  if(user.enabled,
                    do: "bg-emerald-100 text-emerald-800",
                    else: "bg-slate-200 text-slate-600"
                  )
                ]}><span class={[
                  "h-1.5 w-1.5 rounded-full",
                  if(user.enabled, do: "bg-emerald-500", else: "bg-slate-400")
                ]}></span>{if user.enabled, do: "Enabled", else: "Disabled"}</span>
              </td>
              <td class="px-6 py-5 text-right">
                <a
                  id={"edit-user-#{user.id}"}
                  href={user_edit_path(user.id)}
                  class="rounded-lg border border-slate-300 px-3 py-2 text-sm font-semibold text-slate-700 transition hover:border-teal-700 hover:text-teal-800"
                >Manage</a>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>
</Layouts.portal>
