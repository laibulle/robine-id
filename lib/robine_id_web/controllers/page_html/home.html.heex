<main class="landing-shell" style={"--auth-primary: #{@theme.primary_color}"}>
  <nav class="landing-nav" aria-label="Primary navigation">
    <a href="/" class="landing-brand" aria-label="Robine ID home">
      <img :if={@theme.logo} src={@theme.logo} alt="" class="configured-logo nav-logo" />
      <span :if={!@theme.logo} class="brand-mark" aria-hidden="true">R</span>
      <span>{@theme.product_name}</span>
    </a>
    <div class="landing-nav-actions">
      <a href="/docs" class="nav-text-link">Documentation</a>
      <span class={["status-pill", @ready? && "is-ready"]}>
        <span aria-hidden="true"></span>{if @ready?, do: "All systems ready", else: "Starting"}
      </span>
    </div>
  </nav>

  <section class="landing-hero" aria-labelledby="hero-title">
    <p class="eyebrow">Identity, thoughtfully delivered</p>
    <h1 id="hero-title">A secure sign-in experience people will enjoy using.</h1>
    <p class="landing-lead">
      Robine ID is an OpenID Connect provider built for predictable operations, accessible journeys,
      and configuration you can version with confidence.
    </p>
    <div class="landing-actions">
      <a class="primary-link" href={"/#{@issuer_id}/.well-known/openid-configuration"}>
        Open discovery document
      </a>
      <a class="secondary-link" href="/health/ready">Check readiness</a>
    </div>
  </section>

  <section class="feature-grid" aria-label="Product principles">
    <article>
      <span class="feature-number">01</span>
      <h2>Open by design</h2>
      <p>
        Standards-oriented discovery, Authorization Code with PKCE, signed ID tokens, JWKS, and UserInfo.
      </p>
    </article>
    <article>
      <span class="feature-number">02</span>
      <h2>Declarative by default</h2>
      <p>
        Versioned files describe issuers, clients, identities, policies, and branding as one desired state.
      </p>
    </article>
    <article>
      <span class="feature-number">03</span>
      <h2>Safe to repeat</h2>
      <p>
        Validation, preview, atomic activation, and stable fingerprints make every apply predictable.
      </p>
    </article>
  </section>

  <footer class="landing-footer">
    <span>Revision <code>{String.slice(@revision, 0, 12)}</code></span>
    <span>Built with Elixir + Phoenix</span>
  </footer>
</main>
