<main class="auth-shell">
  <section class="auth-card" aria-labelledby="logout-title">
    <div class="brand-mark" aria-hidden="true">✓</div>
    <p class="eyebrow">{@theme.product_name}</p>
    <h1 id="logout-title">You're signed out</h1>
    <p class="auth-intro">You can safely close this window.</p>
  </section>
</main>
