<main class="auth-shell" style={"--auth-primary: #{@theme.primary_color}"}>
  <section class="auth-card" aria-labelledby="consent-title">
    <img :if={@theme.logo} src={@theme.logo} alt={@theme.product_name} class="configured-logo" />
    <img :if={!@theme.logo} src="/images/brand/robine-mark.png" alt="" class="auth-brand-logo" />
    <p class="eyebrow">{@theme.product_name}</p>
    <h1 id="consent-title">{@messages["consent.title"]}</h1>
    <p class="auth-intro"><strong>{@client_name}</strong> would like permission to:</p>

    <ul class="consent-list">
      <li :for={scope <- @scopes}><span aria-hidden="true">✓</span>{scope}</li>
    </ul>

    <.form
      for={%{}}
      as={:consent}
      action={"/#{@issuer_id}/authorize/consent"}
      class="consent-actions"
    >
      <button type="submit" name="decision" value="approve" class="primary-action">
        {@messages["consent.approve"]}
      </button>
      <button type="submit" name="decision" value="deny" class="secondary-action">
        {@messages["consent.deny"]}
      </button>
    </.form>

    <p class="privacy-note">You can revoke access by ending your session.</p>
  </section>
</main>
