<main class="auth-shell">
  <section class="auth-card" aria-labelledby="error-title">
    <div class="error-mark" aria-hidden="true">!</div>
    <p class="eyebrow">Robine ID</p>
    <h1 id="error-title">Unable to continue</h1>
    <div class="error-summary standalone-error" role="alert">
      <strong>{String.replace(@error, "_", " ")}</strong>
      <span>{@description}</span>
    </div>
    <p class="auth-intro">
      Return to the application and start the sign-in process again. If the problem continues,
      share the reference below with support.
    </p>
    <p class="correlation-reference">Reference <code>{@correlation_id}</code></p>
    <a href={RobineId.Runtime.path("/")} class="primary-link error-action">Return to Robine ID</a>
  </section>
</main>
