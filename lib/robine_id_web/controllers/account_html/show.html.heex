<Layouts.portal flash={@flash} current_user={@current_user} theme={@theme} title="Your account">
  <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_20rem]">
    <section
      class="rounded-3xl border border-slate-200/80 bg-white p-7 shadow-xl shadow-slate-900/5 sm:p-10"
      aria-labelledby="account-title"
    >
      <p class="mb-2 text-xs font-bold uppercase tracking-[0.18em] text-teal-700">
        Personal settings
      </p>
      <h1 id="account-title" class="text-3xl font-bold tracking-tight text-slate-900">
        Your account
      </h1>
      <p class="mt-3 max-w-2xl leading-7 text-slate-600">
        Update the profile shared with authorized OpenID applications, or choose a new password.
      </p>

      <.form
        for={@form}
        id="account-profile-form"
        action={RobineId.Runtime.path("/account")}
        method="put"
        class="mt-8 grid gap-5"
      >
        <.input field={@form[:name]} label="Display name" autocomplete="name" required />
        <.input
          field={@form[:email]}
          type="email"
          label="Email address"
          autocomplete="email"
          required
        />

        <div class="my-2 border-t border-slate-200 pt-7">
          <h2 class="text-lg font-semibold text-slate-900">Change password</h2>
          <p class="mt-1 text-sm text-slate-500">
            Leave these fields empty to keep your current password.
          </p>
        </div>
        <.input
          field={@form[:current_password]}
          type="password"
          label="Current password"
          autocomplete="current-password"
        />
        <.input
          field={@form[:new_password]}
          type="password"
          label="New password"
          autocomplete="new-password"
          minlength="12"
        />
        <.input
          field={@form[:password_confirmation]}
          type="password"
          label="Confirm new password"
          autocomplete="new-password"
        />

        <div class="mt-2 flex justify-end">
          <button
            id="account-save"
            type="submit"
            class="rounded-xl bg-teal-700 px-6 py-3 font-semibold text-white shadow-lg shadow-teal-900/10 transition hover:-translate-y-0.5 hover:bg-teal-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700"
          >Save changes</button>
        </div>
      </.form>
    </section>

    <aside
      class="h-fit rounded-3xl border border-slate-200 bg-slate-50 p-6"
      aria-labelledby="identity-title"
    >
      <h2 id="identity-title" class="font-semibold text-slate-900">Managed identity</h2>
      <dl class="mt-5 space-y-5 text-sm">
        <div>
          <dt class="text-slate-500">Sign-in identifier</dt><dd class="mt-1 break-all font-medium text-slate-900">
            {@current_user.identifier}
          </dd>
        </div>
        <div>
          <dt class="text-slate-500">Subject ID</dt><dd class="mt-1 break-all font-mono text-xs text-slate-700">
            {@current_user.id}
          </dd>
        </div>
        <div>
          <dt class="text-slate-500">Roles</dt><dd class="mt-2 flex flex-wrap gap-2">
            <span
              :for={role <- @current_user.roles}
              class="rounded-full bg-teal-100 px-2.5 py-1 text-xs font-semibold text-teal-800"
            >{role}</span><span :if={@current_user.roles == []} class="text-slate-500">No roles assigned</span>
          </dd>
        </div>
      </dl>
    </aside>
  </div>
</Layouts.portal>
