<Layouts.auth theme={@theme} labelledby="login-title" eyebrow={@theme.product_name}>
  <h1 id="login-title">Welcome back</h1>
  <p class="auth-intro">Use the same credentials as your OpenID account.</p>

  <div :if={@error} id="login-error" class="error-summary" role="alert" tabindex="-1">
    <strong>We couldn't sign you in</strong>
    <span>{@error}</span>
  </div>

  <.form
    for={@form}
    id="account-login-form"
    action={RobineId.Runtime.path("/login")}
    class="auth-form"
  >
    <.input
      field={@form[:identifier]}
      type="email"
      label="Email address"
      class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-950 outline-none transition focus:border-[var(--auth-primary)] focus:ring-4 focus:ring-teal-700/10"
      autocomplete="username"
      inputmode="email"
      required
      autofocus
      aria-describedby={if @error, do: "login-error"}
    />

    <div class="password-field">
      <.input
        field={@form[:password]}
        type="password"
        label="Password"
        class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 pr-20 text-slate-950 outline-none transition focus:border-[var(--auth-primary)] focus:ring-4 focus:ring-teal-700/10"
        autocomplete="current-password"
        required
        aria-describedby={if @error, do: "login-error"}
      />
      <button
        type="button"
        class="reveal-password"
        data-password-toggle
        aria-label="Show password"
      >
        Show
      </button>
    </div>

    <button id="account-login-submit" type="submit" class="primary-action">
      Sign in
    </button>
  </.form>

  <p class="privacy-note">Your password stays within Robine ID.</p>
</Layouts.auth>
