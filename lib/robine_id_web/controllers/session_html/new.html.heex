<Layouts.authentication flash={@flash}>
  <RobineIdWeb.AuthenticationComponents.sign_in
    theme={@theme}
    form={@form}
    action={RobineId.Runtime.path("/login")}
    form_id="account-login-form"
    title={@messages["sign_in.title"]}
    intro="Sign in to manage your account"
    identifier_label={@messages["sign_in.identifier"]}
    password_label={@messages["sign_in.password"]}
    submit_label={@messages["sign_in.submit"]}
    privacy_note="Your password stays private and is never displayed in your account."
    error={@error}
    correlation_id={@correlation_id}
  />
</Layouts.authentication>
