<Layouts.portal flash={@flash} current_user={@current_user} theme={@theme} title="Sign in">
  <section class="mx-auto w-full max-w-md" aria-labelledby="login-title">
    <div class="rounded-3xl border border-slate-200/80 bg-white/95 p-7 shadow-xl shadow-slate-900/5 sm:p-10">
      <p class="mb-2 text-xs font-bold uppercase tracking-[0.18em] text-teal-700">
        Account portal
      </p>
      <h1 id="login-title" class="text-3xl font-bold tracking-tight text-slate-900">
        Welcome back
      </h1>
      <p class="mt-3 leading-7 text-slate-600">
        Use the same credentials as your OpenID account.
      </p>

      <div
        :if={@error}
        id="login-error"
        class="mt-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800"
        role="alert"
      >
        {@error}
      </div>

      <.form
        for={@form}
        id="account-login-form"
        action={RobineId.Runtime.path("/login")}
        class="mt-7 space-y-5"
      >
        <.input
          field={@form[:identifier]}
          type="email"
          label="Email address"
          autocomplete="username"
          required
        />
        <.input
          field={@form[:password]}
          type="password"
          label="Password"
          autocomplete="current-password"
          required
        />
        <button
          id="account-login-submit"
          type="submit"
          class="w-full rounded-xl bg-teal-700 px-5 py-3 font-semibold text-white shadow-lg shadow-teal-900/10 transition hover:-translate-y-0.5 hover:bg-teal-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700"
        >
          Sign in
        </button>
      </.form>
    </div>
  </section>
</Layouts.portal>
