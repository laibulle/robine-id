# Generate independent high-entropy values before deployment. Do not define a
# value together with its *_FILE counterpart. See .env.release.files.example
# and compose.release.secrets.yml for file-mounted Docker secrets.
POSTGRES_PASSWORD=replace-with-a-long-random-postgres-password
KEY_ENCRYPTION_SECRET=replace-with-at-least-32-random-bytes
# Optional: generate with make metrics-token. When set, /metrics requires it
# as an HTTP Bearer credential.
# METRICS_BEARER_TOKEN=replace-with-generated-url-safe-token
# Temporary during a staged encryption-secret rotation only:
# KEY_ENCRYPTION_SECRET_PREVIOUS=replace-with-the-former-secret

DATABASE_MAX_CONNECTIONS=10
DATABASE_ACQUIRE_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=5000
DATABASE_CLEANUP_INTERVAL=3600
ROBINE_ID_RELOAD_INTERVAL=1000
DRAIN_DELAY_MILLISECONDS=3000
SHUTDOWN_TIMEOUT_SECONDS=10
TRUST_PROXY_HEADERS=true
RUST_LOG=robine_id=info,actix_web=info

# Add every environment-backed OIDC client secret below, for example:
# PENPOT_OIDC_CLIENT_SECRET=replace-with-the-client-secret
