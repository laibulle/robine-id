# At least 32 random characters. Preserve this secret with the encrypted key store.
SECRET_KEY_BASE=replace-with-a-long-random-secret

# Public cookies must remain secure behind Cloud Run or another HTTPS proxy.
ROBINE_ID_SECURE_COOKIES=true
LOG_LEVEL=info

# Optional confidential relying-party secret used by config/applications/penpot.json.
PENPOT_OIDC_CLIENT_SECRET=replace-with-client-secret
