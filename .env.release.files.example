# Use with compose.release.yml plus compose.release.secrets.yml. This file contains
# paths and non-secret settings only; never put the corresponding secret values here.
# `make deployment-secret-files` creates the two default source files safely.
ROBINE_ID_POSTGRES_PASSWORD_PATH=./deploy/secrets/postgres_password
ROBINE_ID_KEY_ENCRYPTION_SECRET_PATH=./deploy/secrets/key_encryption_secret
# Define only while using compose.release.secrets-rotation.yml:
# ROBINE_ID_KEY_ENCRYPTION_SECRET_PREVIOUS_PATH=./deploy/secrets/key_encryption_secret_previous
# Optionally mount a separate metrics token and set METRICS_BEARER_TOKEN_FILE
# to its in-container path in a deployment-specific override.

DATABASE_MAX_CONNECTIONS=10
DATABASE_ACQUIRE_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=5000
DATABASE_CLEANUP_INTERVAL=3600
ROBINE_ID_RELOAD_INTERVAL=1000
DRAIN_DELAY_MILLISECONDS=3000
SHUTDOWN_TIMEOUT_SECONDS=10
TRUST_PROXY_HEADERS=true
RUST_LOG=robine_id=info,actix_web=info

# For a configured secret key such as CLIENT_SECRET, mount a custom file into
# Robine ID and set CLIENT_SECRET_FILE to its in-container path in an override.
