# Use with compose.release.yml plus compose.release.secrets.yml. This file contains
# paths and non-secret settings only; never put the corresponding secret values here.
ROBINE_ID_POSTGRES_PASSWORD_PATH=./deploy/secrets/postgres_password
ROBINE_ID_KEY_ENCRYPTION_SECRET_PATH=./deploy/secrets/key_encryption_secret

DATABASE_MAX_CONNECTIONS=10
DATABASE_ACQUIRE_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=5000
DATABASE_CLEANUP_INTERVAL=3600
ROBINE_ID_RELOAD_INTERVAL=1000
DRAIN_DELAY_MILLISECONDS=3000
SHUTDOWN_TIMEOUT_SECONDS=10
TRUST_PROXY_HEADERS=true
RUST_LOG=robine_id=info,actix_web=info

# Add every non-secret deployment setting below. Client credentials remain
# environment-backed until their configured secret resolver supports files.
