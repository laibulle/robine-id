{
  "schema_version": 1,
  "kind": "oidc_application",
  "id": "service-token-broker",
  "name": "Service token broker",
  "type": "confidential",
  "redirect_uris": [],
  "resources": [
    "https://api.example.test",
    "https://downstream-api.example.test"
  ],
  "scopes": ["service.read"],
  "grant_types": [
    "client_credentials",
    "urn:ietf:params:oauth:grant-type:token-exchange"
  ],
  "authentication_method": "client_secret_basic",
  "secret_reference": {
    "provider": "env",
    "key": "SERVICE_TOKEN_BROKER_SECRET"
  },
  "introspection_allowed": true,
  "actor_token_exchange_allowed": true
}
