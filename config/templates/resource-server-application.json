{
  "schema_version": 1,
  "kind": "oidc_application",
  "id": "resource-server",
  "name": "Protected Resource Server",
  "type": "confidential",
  "redirect_uris": ["https://resource.example.com/oidc/callback"],
  "resources": ["https://api.example.com"],
  "scopes": ["openid"],
  "grant_types": ["authorization_code"],
  "authentication_method": "client_secret_basic",
  "secret_reference": {
    "provider": "env",
    "key": "RESOURCE_SERVER_CLIENT_SECRET"
  },
  "introspection_allowed": true
}
