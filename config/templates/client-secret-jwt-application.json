{
  "schema_version": 1,
  "kind": "oidc_application",
  "id": "client-secret-jwt-service",
  "name": "Client Secret JWT Service",
  "type": "confidential",
  "redirect_uris": [],
  "post_logout_redirect_uris": [],
  "resources": ["https://api.example.com/"],
  "scopes": ["service.read"],
  "grant_types": ["client_credentials"],
  "authentication_method": "client_secret_jwt",
  "secret_reference": {
    "provider": "env",
    "key": "CLIENT_SECRET_JWT_SECRET"
  },
  "introspection_allowed": true
}
